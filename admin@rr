app.post('/api/shares/withdraw', auth, async (req, res) => {
  try {
    const member = await Member.findById(req.user.id);
    if (req.body.shares > member.currentShares) return res.status(400).json({ message: 'Insufficient shares' });

    const withdrawal = new Withdrawal({
      memberId: member._id, memberName: `${member.firstName} ${member.lastName}`,
      sharesRequested: req.body.shares, withdrawalAmount: req.body.shares,
      reason: req.body.reason, status: 'pending'
    });
    
    await withdrawal.save();
    res.status(201).json({ message: 'Withdrawal requested', withdrawal });
  } catch (error) {
    res.status(400).json({ message: error.message });
  }
});

app.get('/api/members/withdrawals', auth, async (req, res) => {
