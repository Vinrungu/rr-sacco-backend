app.put('/api/admin/approve-withdrawal/:id', auth, async (req, res) => {
  try {
    if (req.user.role !== 'admin') return res.status(403).json({ message: 'Not authorized' });
    const withdrawal = await Withdrawal.findByIdAndUpdate(req.params.id, { status: 'completed' }, { new: true });
    const member = await Member.findById(withdrawal.memberId);
    member.currentShares -= withdrawal.sharesRequested;
    member.totalSavings -= withdrawal.withdrawalAmount;
    await member.save();
    res.json({ message: 'Withdrawal approved', withdrawal });
  } catch (error) {
    res.status(400).json({ message: error.message });
  }
});

