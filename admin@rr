app.post('/api/shares/withdraw-request', auth, async (req, res) => {
    try {
        const member = await Member.findById(req.user.id);
        if (!member) return res.status(404).json({ message: 'Not found' });

        if (req.body.sharesRequested > member.currentShares) {
            return res.status(400).json({ message: 'Insufficient shares' });
        }

        const withdrawal = new Withdrawal({
            memberId: member._id,
            memberName: `${member.firstName} ${member.lastName}`,
            sharesRequested: req.body.sharesRequested,
            withdrawalAmount: req.body.sharesRequested,
            reason: req.body.reason,
            status: 'pending'
        });

        await withdrawal.save();
        res.status(201).json({ message: 'Withdrawal requested', withdrawal });
    } catch (error) {
        res.status(400).json({ message: error.message });
    }
});

