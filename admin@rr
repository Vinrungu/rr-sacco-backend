// ===== MIDDLEWARE =====

const authenticateToken = (req, res, next) => {
    const token = req.headers['authorization']?.split(' ')[1];
    if (!token) return res.status(401).json({ message: 'No token provided' });

    jwt.verify(token, process.env.JWT_SECRET || 'your-secret-key', (err, user) => {
        if (err) return res.status(403).json({ message: 'Invalid token' });
        req.user = user;
        next();
    });
};

const authenticateAdmin = (req, res, next) => {
    const token = req.headers['authorization']?.split(' ')[1];
    if (!token) return res.status(401).json({ message: 'No token provided' });

    jwt.verify(token, process.env.JWT_SECRET || 'your-secret-key', (err, user) => {
        if (err) return res.status(403).json({ message: 'Invalid token' });
        if (user.role !== 'admin') return res.status(403).json({ message: 'Not authorized' });
        req.user = user;
        next();
    });
};

// ===== UTILITY FUNCTIONS =====

const calculateLoanDetails = async (loanAmount, loanType, repaymentPeriod) => {
    const settings = await SaccoSettings.findOne();
    
    let interestRate = 0;
    if (loanType === 'development') interestRate = settings.developmentLoanRate;
    else if (loanType === 'emergency') interestRate = settings.emergencyLoanRate;
    else if (loanType === 'education') interestRate = settings.educationLoanRate;

    const appraisalFee = (loanAmount * settings.appraisalFeePercentage) / 100;
    const netLoanAmount = loanAmount - appraisalFee;

    const monthlyRate = interestRate / 12 / 100;
    const totalInterest = loanAmount * monthlyRate * repaymentPeriod;
    const totalRepayment = loanAmount + totalInterest;
    const monthlyPayment = totalRepayment / repaymentPeriod;

    return {
        appraisalFee,
        netLoanAmount,
        interestRate,
        totalInterest,
        totalRepayment,
        monthlyPayment
    };
};

