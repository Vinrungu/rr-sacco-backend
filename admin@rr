const express = require('express');
const mongoose = require('mongoose');
const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const cors = require('cors');
const path = require('path');
require('dotenv').config();

const app = express();
app.use(cors());
app.use(express.json());
app.use(express.static('public'));

// Connect MongoDB
mongoose.connect(process.env.MONGODB_URI, { useNewUrlParser: true, useUnifiedTopology: true })
  .then(() => console.log('✓ MongoDB Connected'))
  .catch(err => { console.error(err); process.exit(1); });

// ===== SCHEMAS =====
const memberSchema = new mongoose.Schema({
  firstName: String, lastName: String, email: { type: String, unique: true, sparse: true },
  phone: String, idNumber: { type: String, unique: true, sparse: true }, dateOfBirth: Date,
  occupation: String, employer: String, address: String, city: String, nextOfKin: String,
  password: String, initialShares: Number, currentShares: Number, totalSavings: Number,
  status: { type: String, default: 'pending' }, registrationDate: { type: Date, default: Date.now },
  dividendBalance: { type: Number, default: 0 }
});

const loanSchema = new mongoose.Schema({
  memberId: mongoose.Schema.Types.ObjectId, memberName: String, loanType: String,
  requestedAmount: Number, appraisalFee: Number, netLoanAmount: Number, interestRate: Number,
  repaymentPeriod: Number, applicationDate: { type: Date, default: Date.now },
  status: { type: String, default: 'pending' }, monthlyPayment: Number, totalRepayment: Number,
  totalInterest: Number, remainingBalance: Number, loanPurpose: String, collateral: String
});

const withdrawalSchema = new mongoose.Schema({
  memberId: mongoose.Schema.Types.ObjectId, memberName: String, sharesRequested: Number,
  withdrawalAmount: Number, requestDate: { type: Date, default: Date.now },
  status: { type: String, default: 'pending' }, reason: String, approvalDate: Date
});

const adminSchema = new mongoose.Schema({
  username: { type: String, unique: true, sparse: true },
  email: { type: String, unique: true, sparse: true },
  password: String, role: { type: String, default: 'admin' }
});

const Member = mongoose.model('Member', memberSchema);
const Loan = mongoose.model('Loan', loanSchema);
const Withdrawal = mongoose.model('Withdrawal', withdrawalSchema);
const Admin = mongoose.model('Admin', adminSchema);

// Initialize Admin
(async () => {
  const admin = await Admin.findOne({ username: 'admin' });
  if (!admin) {
    const pwd = await bcrypt.hash('admin123', 10);
    await Admin.create({ username: 'admin', email: 'admin@rrsacco.co.ke', password: pwd });
    console.log('✓ Admin Created: admin / admin123');
  }
})();

// ===== MIDDLEWARE =====
const auth = (req, res, next) => {
  const token = req.headers['authorization']?.split(' ')[1];
  if (!token) return res.status(401).json({ message: 'No token' });
  try {
    req.user = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    next();
  } catch (e) {
    res.status(403).json({ message: 'Invalid token' });
  }
};

// ===== MEMBER ROUTES =====
app.post('/api/members/register', async (req, res) => {
  try {
    const pwd = await bcrypt.hash(req.body.password, 10);
    const member = new Member({
      firstName: req.body.firstName, lastName: req.body.lastName, email: req.body.email,
      phone: req.body.phone, idNumber: req.body.idNumber, dateOfBirth: req.body.dateOfBirth,
      occupation: req.body.occupation, employer: req.body.employer, address: req.body.address,
      city: req.body.city, nextOfKin: req.body.nextOfKin, password: pwd,
      initialShares: req.body.initialShares, currentShares: req.body.initialShares,
      totalSavings: req.body.initialShares, status: 'pending'
    });
    await member.save();
    res.status(201).json({ message: 'Registration successful' });
  } catch (error) {
    res.status(400).json({ message: error.message });
  }
});

app.post('/api/members/login', async (req, res) => {
  try {
    const member = await Member.findOne({ email: req.body.email });
    if (!member || member.status !== 'approved') return res.status(403).json({ message: 'Not approved' });
    if (!await bcrypt.compare(req.body.password, member.password)) return res.status(401).json({ message: 'Invalid' });
    
    const token = jwt.sign({ id: member._id, role: 'member' }, process.env.JWT_SECRET || 'secret');
    res.json({ token, member: { id: member._id, firstName: member.firstName, lastName: member.lastName } });
  } catch (error) {
    res.status(400).json({ message: error.message });
  }
});

app.get('/api/members/profile', auth, async (req, res) => {
  try {
    const member = await Member.findById(req.user.id);
    const loans = await Loan.find({ memberId: member._id });
    const outstanding = loans.filter(l => l.status === 'approved' || l.status === 'repaying')
      .reduce((sum, l) => sum + (l.remainingBalance || 0), 0);
    
    res.json({
      member: {
        _id: member._id, firstName: member.firstName, lastName: member.lastName,
        email: member.email, phone: member.phone, currentShares: member.currentShares,
        totalSavings: member.totalSavings, dividendBalance: member.dividendBalance,
        outstandingLoans: outstanding, loans
      }
    });
  } catch (error) {
    res.status(400).json({ message: error.message });
  }
});

app.get('/api/loans/info', auth, async (req, res) => {
  try {
    const member = await Member.findById(req.user.id);
    const loans = await Loan.find({ memberId: member._id, status: { $in: ['approved', 'repaying'] } });
    const total = loans.reduce((sum, l) => sum + (l.remainingBalance || 0), 0);
    const maxLoan = member.currentShares * 4;

    res.json({
      memberDetails: { currentShares: member.currentShares, totalSavings: member.totalSavings },
      loanLimits: { maxLoanAmount: maxLoan },
      outstandingLoans: { count: loans.length, totalAmount: total },
      rates: { development: 11, emergency: 7, education: 9, appraisal: 2 }
    });
  } catch (error) {
    res.status(400).json({ message: error.message });
  }
});

app.post('/api/loans/request', auth, async (req, res) => {
  try {
    const member = await Member.findById(req.user.id);
    const maxLoan = member.currentShares * 4;
    
    if (req.body.amount > maxLoan) return res.status(400).json({ message: 'Exceeds max loan' });

    const appraisal = (req.body.amount * 2) / 100;
    const rate = { development: 11, emergency: 7, education: 9 }[req.body.loanType] || 11;
    const totalInterest = req.body.amount * (rate / 100) * (req.body.repaymentPeriod / 12);
    const totalRepayment = req.body.amount + totalInterest;

    const loan = new Loan({
      memberId: member._id, memberName: `${member.firstName} ${member.lastName}`,
      loanType: req.body.loanType, requestedAmount: req.body.amount, appraisalFee: appraisal,
      netLoanAmount: req.body.amount - appraisal, interestRate: rate,
      repaymentPeriod: req.body.repaymentPeriod, totalInterest, totalRepayment,
      monthlyPayment: totalRepayment / req.body.repaymentPeriod, remainingBalance: totalRepayment,
      loanPurpose: req.body.loanPurpose, collateral: req.body.collateral, status: 'pending'
    });
    
    await loan.save();
    res.status(201).json({ message: 'Loan request submitted', loan });
  } catch (error) {
    res.status(400).json({ message: error.message });
  }
});

app.get('/api/members/loans', auth, async (req, res) => {
  try {
    const loans = await Loan.find({ memberId: req.user.id });
