app.put('/api/admin/settings', authenticateAdmin, async (req, res) => {
    try {
        let settings = await SaccoSettings.findOne();
        if (!settings) {
            settings = new SaccoSettings();
        }

        settings.developmentLoanRate = req.body.developmentLoanRate || settings.developmentLoanRate;
        settings.emergencyLoanRate = req.body.emergencyLoanRate || settings.emergencyLoanRate;
        settings.educationLoanRate = req.body.educationLoanRate || settings.educationLoanRate;
        settings.currentDividendPercentage = req.body.currentDividendPercentage || settings.currentDividendPercentage;
        settings.appraisalFeePercentage = req.body.appraisalFeePercentage || settings.appraisalFeePercentage;
        settings.minCapitalRetention = req.body.minCapitalRetention || settings.minCapitalRetention;
        settings.fixedDividendReserve = req.body.fixedDividendReserve || settings.fixedDividendReserve;
        settings.lastUpdated = new Date();
        settings.updatedBy = req.user.username;

        await settings.save();
        res.json({ message: 'Settings updated', settings });
    } catch (error) {
        res.status(400).json({ message: error.message });
    }
});

app.get('/api/admin/overview', authenticateAdmin, async (req, res) => {
    try {
        const settings = await SaccoSettings.findOne();
        const members = await Member.countDocuments({ status: 'approved' });
        const totalShares = await Member.aggregate([
            { $match: { status: 'approved' } },
            { $group: { _id: null, total: { $sum: '$currentShares' } } }
        ]);
        const loans = await Loan.find({ status: { $in: ['approved', 'repaying'] } });
        const totalLoansOutstanding = loans.reduce((sum, loan) => sum + loan.remainingBalance, 0);

        res.json({
            settings: settings || {},
            stats: {
                totalMembers: members,
                totalShares: totalShares[0]?.total || 0,
                totalLoansIssued: loans.reduce((sum, loan) => sum + loan.requestedAmount, 0),
                totalLoansOutstanding: totalLoansOutstanding,
                pendingLoans: await Loan.countDocuments({ status: 'pending' }),
                pendingMembers: await Member.countDocuments({ status: 'pending' }),
                pendingWithdrawals: await Withdrawal.countDocuments({ status: 'pending' })
            }
        });
    } catch (error) {
        res.status(400).json({ message: error.message });
    }
});

app.get('/api/admin/members', authenticateAdmin, async (req, res) => {
    try {
        const members = await Member.find({ status: 'approved' }).select('-password');
        res.json(members);
    } catch (error) {
        res.status(400).json({ message: error.message });
    }
});

