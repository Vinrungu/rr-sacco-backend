app.post('/api/loans/request', authenticateToken, async (req, res) => {
    try {
        const member = await Member.findById(req.user.id);
        if (!member) return res.status(404).json({ message: 'Member not found' });

        const settings = await SaccoSettings.findOne();

        if (member.currentShares < settings.minSharesPerMember) {
            return res.status(400).json({ 
                message: `Minimum shares required: KSh ${settings.minSharesPerMember}` 
            });
        }

        const maxLoan = member.currentShares * settings.maxLoanMultiplier;
        if (req.body.amount > maxLoan) {
            return res.status(400).json({ 
                message: `Loan amount cannot exceed KSh ${maxLoan} (4x your shares)` 
            });
        }

        const outstandingLoans = await Loan.find({ 
            memberId: member._id, 
            status: { $in: ['approved', 'repaying'] } 
        });

        if (outstandingLoans.length > 0 && req.body.loanType === 'emergency') {
            return res.status(400).json({ 
                message: 'Cannot apply for emergency loan while having other outstanding loans' 
            });
        }

        const pendingWithdrawal = await Withdrawal.findOne({
            memberId: member._id,
            status: 'pending'
        });

        if (pendingWithdrawal) {
            return res.status(400).json({ 
                message: 'Cannot apply for loan while withdrawal request is pending' 
            });
        }

        const loanDetails = await calculateLoanDetails(
            req.body.amount,
            req.body.loanType,
            req.body.repaymentPeriod
        );

        const loan = new Loan({
            memberId: member._id,
            memberName: `${member.firstName} ${member.lastName}`,
            loanType: req.body.loanType,
            requestedAmount: req.body.amount,
            appraisalFee: loanDetails.appraisalFee,
            netLoanAmount: loanDetails.netLoanAmount,
            maxAllowedLoan: maxLoan,
            interestRate: loanDetails.interestRate,
            repaymentPeriod: req.body.repaymentPeriod,
            totalInterest: loanDetails.totalInterest,
            monthlyPayment: loanDetails.monthlyPayment,
            totalRepayment: loanDetails.totalRepayment,
            remainingBalance: loanDetails.totalRepayment,
            loanPurpose: req.body.loanPurpose,
            collateral: req.body.collateral,
            status: 'pending'
        });

        await loan.save();
        
        res.status(201).json({ 
            message: 'Loan application submitted successfully',
            loan: loan,
            loanDetails: {
                requestedAmount: req.body.amount,
                appraisalFee: loanDetails.appraisalFee,
                netLoanAmount: loanDetails.netLoanAmount,
                interestRate: loanDetails.interestRate,
                totalInterest: loanDetails.totalInterest,
                monthlyPayment: loanDetails.monthlyPayment,
                totalRepayment: loanDetails.totalRepayment
            }
        });
    } catch (error) {
        res.status(400).json({ message: error.message });
    }
});

