app.post('/api/shares/withdraw-request', authenticateToken, async (req, res) => {
    try {
        const member = await Member.findById(req.user.id);
        if (!member) return res.status(404).json({ message: 'Member not found' });

        const settings = await SaccoSettings.findOne();

        const outstandingLoans = await Loan.find({
            memberId: member._id,
            status: { $in: ['approved', 'repaying'] }
        });

        if (outstandingLoans.length > 0) {
            return res.status(400).json({ 
                message: 'Cannot withdraw shares while having outstanding loans. Pay off all loans first.' 
            });
        }

        if (req.body.sharesRequested > member.currentShares) {
            return res.status(400).json({ 
                message: 'Cannot withdraw more shares than you currently have' 
            });
        }

        const sharesAfterWithdrawal = member.currentShares - req.body.sharesRequested;
        if (sharesAfterWithdrawal < settings.minSharesPerMember) {
            return res.status(400).json({ 
                message: `Must retain minimum KSh ${settings.minSharesPerMember} in shares` 
            });
        }

        const pendingWithdrawal = await Withdrawal.findOne({
            memberId: member._id,
            status: 'pending'
        });

        if (pendingWithdrawal) {
            return res.status(400).json({ 
                message: 'You already have a pending withdrawal request' 
            });
        }

        const withdrawal = new Withdrawal({
            memberId: member._id,
            memberName: `${member.firstName} ${member.lastName}`,
            sharesRequested: req.body.sharesRequested,
            withdrawalAmount: req.body.sharesRequested,
            reason: req.body.reason,
            hasOutstandingLoans: outstandingLoans.length > 0,
            status: 'pending'
        });

        await withdrawal.save();

        res.status(201).json({ 
            message: 'Withdrawal request submitted successfully',
            withdrawal: withdrawal
        });
    } catch (error) {
        res.status(400).json({ message: error.message });
    }
});

