const express = require('express');
const mongoose = require('mongoose');
const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const cors = require('cors');
const path = require('path');
require('dotenv').config();

const app = express();

// Middleware
app.use(cors());
app.use(express.json());
app.use(express.static('public'));

console.log('Starting RR SACCO Server...');

// MongoDB Connection
mongoose.connect(process.env.MONGODB_URI, {
    useNewUrlParser: true,
    useUnifiedTopology: true
})
.then(() => console.log('✓ MongoDB Connected'))
.catch(err => {
    console.error('MongoDB Error:', err.message);
    process.exit(1);
});

// Schemas
const memberSchema = new mongoose.Schema({
    firstName: String,
    lastName: String,
    email: { type: String, unique: true, sparse: true },
    phone: String,
    idNumber: { type: String, unique: true, sparse: true },
    dateOfBirth: Date,
    occupation: String,
    employer: String,
    address: String,
    city: String,
    nextOfKin: String,
    password: String,
    initialShares: { type: Number, default: 500 },
    currentShares: { type: Number, default: 0 },
    totalSavings: { type: Number, default: 0 },
    status: { type: String, enum: ['pending', 'approved', 'rejected'], default: 'pending' },
    registrationDate: { type: Date, default: Date.now },
    approvedDate: Date,
    approvedBy: String,
    dividendBalance: { type: Number, default: 0 }
});

const loanSchema = new mongoose.Schema({
    memberId: mongoose.Schema.Types.ObjectId,
    memberName: String,
    loanType: String,
    requestedAmount: Number,
    appraisalFee: Number,
    netLoanAmount: Number,
    interestRate: Number,
    repaymentPeriod: Number,
    applicationDate: { type: Date, default: Date.now },
    status: { type: String, default: 'pending' },
    approvalDate: Date,
    monthlyPayment: Number,
    totalRepayment: Number,
    totalInterest: Number,
    remainingBalance: Number,
    loanPurpose: String,
    collateral: String
});

const withdrawalSchema = new mongoose.Schema({
    memberId: mongoose.Schema.Types.ObjectId,
    memberName: String,
    sharesRequested: Number,
    withdrawalAmount: Number,
    requestDate: { type: Date, default: Date.now },
    status: { type: String, default: 'pending' },
    reason: String,
    approvalDate: Date,
    approvedBy: String
});

const saccoSettingsSchema = new mongoose.Schema({
    developmentLoanRate: { type: Number, default: 11 },
    emergencyLoanRate: { type: Number, default: 7 },
    educationLoanRate: { type: Number, default: 9 },
    currentDividendPercentage: { type: Number, default: 15 },
    appraisalFeePercentage: { type: Number, default: 2 },
    minSharesPerMember: { type: Number, default: 500 },
    maxLoanMultiplier: { type: Number, default: 4 }
});

const adminSchema = new mongoose.Schema({
    username: { type: String, unique: true, sparse: true },
    email: { type: String, unique: true, sparse: true },
    password: String,
    role: { type: String, default: 'admin' },
    createdDate: { type: Date, default: Date.now }
});

// Models
const Member = mongoose.model('Member', memberSchema);
const Loan = mongoose.model('Loan', loanSchema);
const Withdrawal = mongoose.model('Withdrawal', withdrawalSchema);
const SaccoSettings = mongoose.model('SaccoSettings', saccoSettingsSchema);
const Admin = mongoose.model('Admin', adminSchema);

// Initialize Admin
async function initAdmin() {
    try {
        const admin = await Admin.findOne({ username: 'admin' });
        if (!admin) {
            const pwd = await bcrypt.hash('admin123', 10);
            await Admin.create({
                username: 'admin',
                email: 'admin@rrsacco.co.ke',
                password: pwd
            });
            console.log('✓ Admin created');
        }
    } catch (e) {
        console.log('Admin init:', e.message);
    }
}

// Middleware
const auth = (req, res, next) => {
    const token = req.headers['authorization']?.split(' ')[1];
    if (!token) return res.status(401).json({ message: 'No token' });
    try {
        const user = jwt.verify(token, process.env.JWT_SECRET || 'secret');
        req.user = user;
        next();
    } catch (e) {
        res.status(403).json({ message: 'Invalid token' });
    }
};

// Routes - Members
app.post('/api/members/register', async (req, res) => {
    try {
        const hashedPassword = await bcrypt.hash(req.body.password, 10);
        const member = new Member({
            firstName: req.body.firstName,
            lastName: req.body.lastName,
            email: req.body.email,
            phone: req.body.phone,
            idNumber: req.body.idNumber,
            dateOfBirth: req.body.dateOfBirth,
            occupation: req.body.occupation,
            employer: req.body.employer,
            address: req.body.address,
            city: req.body.city,
            nextOfKin: req.body.nextOfKin,
            password: hashedPassword,
            initialShares: req.body.initialShares,
            currentShares: req.body.initialShares,
            totalSavings: req.body.initialShares,
            status: 'pending'
        });
        await member.save();
        res.status(201).json({ message: 'Registration successful' });
    } catch (error) {
        res.status(400).json({ message: error.message });
    }
});

app.post('/api/members/login', async (req, res) => {
    try {
        const member = await Member.findOne({ email: req.body.email });
        if (!member) return res.status(404).json({ message: 'Not found' });
        if (member.status !== 'approved') return res.status(403).json({ message: 'Not approved' });
        
        const valid = await bcrypt.compare(req.body.password, member.password);
        if (!valid) return res.status(401).json({ message: 'Invalid password' });

        const token = jwt.sign(
            { id: member._id, email: member.email, role: 'member' },
            process.env.JWT_SECRET || 'secret'
        );
        res.json({ token, member: { id: member._id, firstName: member.firstName, lastName: member.lastName } });
    } catch (error) {
        res.status(400).json({ message: error.message });
    }
});

app.get('/api/members/profile', auth, async (req, res) => {
    try {
        const member = await Member.findById(req.user.id);
        if (!member) return res.status(404).json({ message: 'Not found' });
        
        const loans = await Loan.find({ memberId: member._id });
        const outstandingLoans = loans
            .filter(l => l.status === 'approved' || l.status === 'repaying')
            .reduce((sum, l) => sum + (l.remainingBalance || 0), 0);

        res.json({
            member: {
                _id: member._id,
                firstName: member.firstName,
                lastName: member.lastName,
                email: member.email,
                phone: member.phone,
                currentShares: member.currentShares,
                totalSavings: member.totalSavings,
                dividendBalance: member.dividendBalance,
                outstandingLoans,
                loans
            }
        });
    } catch (error) {
        res.status(400).json({ message: error.message });
    }
});

app.get('/api/loans/info', auth, async (req, res) => {
    try {
        const member = await Member.findById(req.user.id);
        const settings = await SaccoSettings.findOne();
        
        const loans = await Loan.find({ memberId: member._id, status: { $in: ['approved', 'repaying'] } });
        const total = loans.reduce((sum, l) => sum + (l.remainingBalance || 0), 0);
        const maxLoan = member.currentShares * (settings?.maxLoanMultiplier || 4);

        res.json({
            memberDetails: {
                currentShares: member.currentShares,
                totalSavings: member.totalSavings,
                dividendBalance: member.dividendBalance
            },
            loanLimits: {
                maxLoanAmount: maxLoan,
                maxLoanMultiplier: settings?.maxLoanMultiplier || 4
            },
            outstandingLoans: {
                count: loans.length,
                totalAmount: total
            },
            rates: {
                developmentLoanRate: settings?.developmentLoanRate || 11,
                emergencyLoanRate: settings?.emergencyLoanRate || 7,
                educationLoanRate: settings?.educationLoanRate || 9,
                appraisalFeePercentage: settings?.appraisalFeePercentage || 2
            }
        });
    } catch (error) {
        res.status(400).json({ message: error.message });
    }
});

app.post('/api/loans/request', auth, async (req, res) => {
    try {
        const member = await Member.findById(req.user.id);
        if (!member) return res.status(404).json({ message: 'Not found' });

        const settings = await SaccoSettings.findOne();
        const maxLoan = member.currentShares * (settings?.maxLoanMultiplier || 4);

        if (req.body.amount > maxLoan) {
            return res.status(400).json({ message: `Max loan: ${maxLoan}` });
        }

        const appraisalFee = (req.body.amount * (settings?.appraisalFeePercentage || 2)) / 100;
        const rate = { development: 11, emergency: 7, education: 9 }[req.body.loanType] || 11;
        const monthlyRate = rate / 12 / 100;
        const totalInterest = req.body.amount * monthlyRate * req.body.repaymentPeriod;
        const totalRepayment = req.body.amount + totalInterest;
        const monthlyPayment = totalRepayment / req.body.repaymentPeriod;

        const loan = new Loan({
            memberId: member._id,
            memberName: `${member.firstName} ${member.lastName}`,
            loanType: req.body.loanType,
            requestedAmount: req.body.amount,
            appraisalFee,
            netLoanAmount: req.body.amount - appraisalFee,
            interestRate: rate,
            repaymentPeriod: req.body.repaymentPeriod,
            totalInterest,
            monthlyPayment,
            totalRepayment,
            remainingBalance: totalRepayment,
            loanPurpose: req.body.loanPurpose,
            collateral: req.body.collateral,
            status: 'pending'
        });

        await loan.save();
        res.status(201).json({ message: 'Loan request submitted', loan });
    } catch (error) {
        res.status(400).json({ message: error.message });
    }
});

