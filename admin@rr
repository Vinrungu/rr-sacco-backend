        const loans = await Loan.find({ memberId: member._id });
        
        const outstandingLoans = loans.filter(loan => 
            loan.status === 'approved' || loan.status === 'repaying'
        ).reduce((sum, loan) => sum + loan.remainingBalance, 0);

        const pendingWithdrawals = await Withdrawal.find({ 
            memberId: member._id, 
            status: 'pending' 
        });

        res.json({
            member: {
                _id: member._id,
                firstName: member.firstName,
                lastName: member.lastName,
                email: member.email,
                phone: member.phone,
                occupation: member.occupation,
                currentShares: member.currentShares,
                totalSavings: member.totalSavings,
                dividendBalance: member.dividendBalance,
                registrationDate: member.registrationDate,
                outstandingLoans: outstandingLoans,
